# Android signing artefacts. The release keystore is private and lives
# outside the repo; CI gets it via base64-encoded secrets. Never commit.
*.jks
*.keystore
signing.properties
keystore.properties

# Build outputs that occasionally land at the repo root if a script
# extracts them there (e.g. while testing the CI workflow locally).
*.apk
*.aab
