-- One row per paired smart cube, scoped to a profile (user_id). Hardware
-- info columns (hw_version, sw_version, gyro_supported) are populated
-- after the cube's INFO round-trip; nullable for the brief window before
-- that lands and for non-GAN drivers that may never report them.
--
-- `name` is the name the cube ADVERTISES over BLE — the manufacturer's,
-- shared by every profile, because it is a property of the hardware. A
-- user's own name for a cube lives in `cube_names`, keyed by profile;
-- see CubeNames.sq for why the two are separate.
--
-- gyro_supported is INTEGER for SQLite-correctness (0/1/NULL); the
-- repository maps to Boolean? at the model boundary.
--
-- vendor is the persisted form of [CubeVendor]: lowercase ASCII key
-- ('gan' / 'moyu'). Default 'gan' covers any new rows inserted before
-- the vendor is known – the connection orchestrator stamps the real
-- value once service discovery completes. Not nullable so the
-- repository can map directly without an Elvis chain.

CREATE TABLE cubes (
    id TEXT NOT NULL PRIMARY KEY,
    mac TEXT NOT NULL UNIQUE,
    name TEXT,
    last_seen INTEGER NOT NULL,
    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    hw_version TEXT,
    sw_version TEXT,
    gyro_supported INTEGER,  -- 0 = no, 1 = yes, NULL = unknown (pre-INFO)
    vendor TEXT NOT NULL DEFAULT 'gan'  -- CubeVendor.key; default before detection
);

CREATE INDEX cubes_user_id ON cubes(user_id);

-- The paired list for one profile, with that profile's name override (if
-- any) attached. LEFT JOIN so a cube the profile has never renamed still
-- comes back, with custom_name NULL; the repository resolves
-- custom_name ?: name for display.
--
-- One query rather than two-and-combine: SQLDelight notifies a query when
-- ANY table it reads is written, so a rename lands on this query's
-- listeners exactly like a cube insert does, and the list is never
-- momentarily assembled from a fresh cube row and a stale name map.
selectByUser:
SELECT c.id, c.mac, c.name, c.last_seen, c.user_id, c.hw_version,
       c.sw_version, c.gyro_supported, c.vendor, n.name AS custom_name
FROM cubes c
LEFT JOIN cube_names n ON n.user_id = c.user_id AND n.mac = c.mac
WHERE c.user_id = :userId
ORDER BY c.last_seen DESC;

selectById:
SELECT * FROM cubes WHERE id = :id;

selectByMac:
SELECT * FROM cubes WHERE mac = :mac;

-- Upsert by MAC. On conflict we update last_seen AND user_id.
-- The user_id update is critical for multi-profile flows: a cube that
-- was previously paired under profile A and is now being paired under
-- profile B must transfer ownership; otherwise selectByUser(B) won't
-- return it and the cube is invisible in B's Paired list. (The id is
-- preserved on conflict so any in-memory references to the row stay
-- valid.)
--
-- name takes the newly-advertised value whenever the cube reports one,
-- and keeps the previous value when it doesn't (COALESCE on the
-- *excluded* side, not the stored one). This column is now purely the
-- cube's own advertised name, so tracking the latest is exactly right.
--
-- It used to be the opposite — fill-only, so a stored name was never
-- overwritten — because user renames lived in this column and every
-- reconnect would otherwise stamp the manufacturer's name back over
-- them. Renames now live in `cube_names`, out of the way, and this
-- clause went back to meaning what it says.
--
-- vendor is NOT touched on conflict: a re-pair of the same physical
-- cube under a different profile keeps whatever vendor was previously
-- detected for that MAC, and the connection orchestrator will
-- overwrite it via [updateVendor] if the post-handshake detection
-- disagrees.
upsert:
INSERT INTO cubes (id, mac, name, last_seen, user_id)
VALUES (:id, :mac, :name, :lastSeen, :userId)
ON CONFLICT(mac) DO UPDATE SET
    name = COALESCE(excluded.name, name),
    last_seen = excluded.last_seen,
    user_id = excluded.user_id;

updateHardwareInfo:
-- Every field is refine-only: a parameter meaning "not established yet"
-- (NULL for the flag, empty string for a version) leaves whatever is
-- already recorded alone. This query is called repeatedly within one
-- connection — GAN Gen4 reports its hardware across four separate
-- notifications, and the orchestrator re-requests until the cube answers
-- — so straight assignment would let a partial reply blank out fields an
-- earlier one had filled. The update must only ever go forwards.
UPDATE cubes SET hw_version = COALESCE(NULLIF(:hwVersion, ''), hw_version),
                 sw_version = COALESCE(NULLIF(:swVersion, ''), sw_version),
                 gyro_supported = COALESCE(:gyroSupported, gyro_supported)
WHERE mac = :mac;

-- Record that a cube demonstrably has a gyroscope, because it just sent
-- gyro data. Empirical evidence beats any declared capability: it cannot
-- be wrong, it needs no hardware-name catalogue, and it still works when
-- the hardware handshake never completes at all.
markGyroSupported:
UPDATE cubes SET gyro_supported = 1 WHERE mac = :mac;

-- Stamp the detected vendor onto an already-paired cube. Called by the
-- connection orchestrator immediately after service-UUID inspection,
-- well before the INFO round-trip completes – the vendor is known the
-- moment we pick which driver to dispatch to, and the value never
-- changes for a given cube across reconnects.
updateVendor:
UPDATE cubes SET vendor = :vendor WHERE mac = :mac;

deleteById:
DELETE FROM cubes WHERE id = :id;

deleteAllForUser:
DELETE FROM cubes WHERE user_id = :userId;
