-- Recorded solve. Scoped to a profile (user_id). Insert-only on the timer
-- side; rows can be deleted from the History screen.
--
-- Penalty/DNF semantics:
--   • is_dnf = 1: solve is a Did-Not-Finish. duration_ms still recorded
--     for reference but UI shows "DNF" instead of the number, and stats
--     (best/mean/AoN) skip these rows.
--   • penalty_ms (typically 2000): a "+2" penalty added to the displayed
--     duration. The raw duration_ms is the un-penalised time; the
--     effective time is duration_ms + penalty_ms. Stats use the
--     effective time.
-- Both columns default to 0 – i.e. a fresh solve is neither DNF nor +2.
--
-- move_count: total cube turns recorded during the solve. Already
-- counted at runtime by SolveViewModel for the live TPS calculation
-- (`fluency = moveCount * 1000.0 / durationMs`). Persisting it lets the
-- History detail dialog surface "turns: N" without recomputing from a
-- gesture stream we no longer have. Defaults to 0 so old call sites
-- (e.g. tests inserting via the repo without the new field) keep
-- compiling. Not used by any stat – it's a History-only field by
-- product spec.
--
-- ao5_times: the five effective times the row's `ao5_ms` was computed
-- from, oldest first, comma-separated, with a DNF written as `D` –
-- e.g. `12402,29351,D,39537,10112`. NULL exactly when the profile had
-- fewer than five solves at this point and there was no window at all.
--
-- Note this is NOT the same condition as `ao5_ms IS NULL`. A window
-- holding two or more DNFs has five real times but no average (the WCA
-- rule), so the pair reads `ao5_times` present, `ao5_ms` NULL, and the
-- UI shows the five times under a "DNF" average. The two columns answer
-- two different questions – "was there a window" and "did it produce a
-- number" – and collapsing them would lose the distinction.
--
-- It is a *snapshot*, deliberately not five foreign keys: deleting one
-- of the contributing solves must not erase what the average was made
-- of, and the five rows may be far outside any window the app still has
-- in memory.
--
-- cube_mac: which physical cube the solve was done on, so History can
-- filter and group by cube. **Deliberately not a foreign key.** cubes.mac
-- is UNIQUE so an FK would be legal, but it would force forgetting a cube
-- to either cascade-delete its solves or be refused, and neither is what
-- "forget this cube" means. The MAC outlives the `cubes` row anyway – a
-- forget-and-re-pair mints a fresh cubes.id but the same MAC – which is
-- the same reasoning `cube_names` is keyed by MAC rather than by id.
-- NULL for solves recorded before this column existed.

CREATE TABLE solves (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    solved_at INTEGER NOT NULL,
    duration_ms INTEGER NOT NULL,
    scramble TEXT NOT NULL,
    ao5_ms INTEGER,
    fluency REAL,
    extras TEXT,
    is_dnf INTEGER NOT NULL DEFAULT 0,
    penalty_ms INTEGER NOT NULL DEFAULT 0,
    move_count INTEGER NOT NULL DEFAULT 0,
    ao5_times TEXT,
    cube_mac TEXT
);

CREATE INDEX solves_user_solved_at ON solves(user_id, solved_at DESC);

-- Ranking index. Column order mirrors the History "best/worst" ORDER BY
-- exactly – (user_id, is_dnf, effective time) – which buys three separate
-- things from one index:
--
--   • `bestDuration` becomes a MIN() index seek. `user_id` and `is_dnf`
--     are both equalities in that query and the MIN argument is the very
--     next indexed expression, which is precisely the shape SQLite's
--     MIN/MAX optimisation looks for. Measured on a 100k-solve database:
--     59 ms -> 0.02 ms.
--   • `pageByDurationAsc` reads straight off the index in order, with no
--     sort step. It previously did a full table SCAN plus a temp B-tree
--     for the ORDER BY *on every page* – 14.5 ms per 50-row page at 100k
--     solves, against 0.17 ms now.
--   • `pageByDurationDesc` sorts by exactly the reverse of this index
--     (is_dnf DESC, effective DESC), so SQLite walks the same index
--     backwards. One index, both directions.
--
-- This replaces the old `solves_user_duration ON solves(user_id,
-- duration_ms)`, which served none of the three. Its column was the RAW
-- duration while every query here works in *effective* time
-- (duration_ms + penalty_ms), and an index cannot be used for an
-- expression it doesn't contain – so `bestDuration` was reading each
-- candidate row out of the table to add the penalty and check the DNF
-- flag, and the History sorts ignored it entirely. Dropped in the
-- migration; nothing else referenced it.
CREATE INDEX solves_user_rank ON solves(user_id, is_dnf ASC, (duration_ms + penalty_ms) ASC);

-- Best-Ao5 lookup. Partial, so it holds only rows that actually have an
-- Ao5 (the first four solves of a profile never do) and `MIN(ao5_ms)`
-- is answered from the index alone without touching the table.
CREATE INDEX solves_user_ao5 ON solves(user_id, ao5_ms) WHERE ao5_ms IS NOT NULL;

-- "Solves done on this cube, newest first". Same shape as
-- solves_user_solved_at with the MAC wedged in as a second equality, so
-- filtering by cube keeps the date ordering for free.
CREATE INDEX solves_user_cube ON solves(user_id, cube_mac, solved_at DESC);

insert:
INSERT INTO solves (user_id, solved_at, duration_ms, scramble, ao5_ms, ao5_times, fluency, extras, is_dnf, penalty_ms, move_count, cube_mac)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- SQLite-specific: returns the id of the most recently INSERTed row in
-- the current connection. Used immediately after `insert` (in the same
-- transaction) to surface the new solve's id back to the caller.
lastInsertedId:
SELECT last_insert_rowid();

deleteById:
DELETE FROM solves WHERE id = :id;

countAll:
SELECT COUNT(*) FROM solves WHERE user_id = :userId;

bestDuration:
-- Skips DNF rows. Effective time = duration_ms + penalty_ms.
-- The explicit `AS best` alias gives the generated row class a stable
-- Kotlin property name, so changes to the SELECT expression don't
-- silently rename the property.
--
-- Answered by `solves_user_rank` as a MIN() index seek – see that index's
-- note. It is O(log n): a profile with 500k solves costs the same as one
-- with 500, which is what makes it safe to re-read on every profile
-- switch rather than caching a denormalised copy.
SELECT MIN(duration_ms + penalty_ms) AS best FROM solves
WHERE user_id = :userId AND is_dnf = 0;

bestAo5:
-- Best (lowest) Ao5 ever recorded by this profile. Answered from the
-- partial `solves_user_ao5` covering index without reading the table.
--
-- Reads the persisted per-solve `ao5_ms` rather than recomputing sliding
-- windows, which is only sound because that column is now maintained:
-- `recomputeAo5From` re-derives it for every affected row after a penalty
-- change or a delete, and `3.sqm` backfilled it for history.
SELECT MIN(ao5_ms) AS best FROM solves
WHERE user_id = :userId AND ao5_ms IS NOT NULL;

recentForStats:
SELECT * FROM solves WHERE user_id = :userId
ORDER BY solved_at DESC LIMIT :n;

pageByDateDesc:
SELECT * FROM solves WHERE user_id = :userId
ORDER BY solved_at DESC LIMIT :limit OFFSET :offset;

pageByDateAsc:
SELECT * FROM solves WHERE user_id = :userId
ORDER BY solved_at ASC LIMIT :limit OFFSET :offset;

pageByDurationAsc:
-- Best ordering: DNFs go to the bottom regardless of recorded ms;
-- among non-DNFs, effective time (duration_ms + penalty_ms) ascending.
SELECT * FROM solves WHERE user_id = :userId
ORDER BY is_dnf ASC, (duration_ms + penalty_ms) ASC LIMIT :limit OFFSET :offset;

pageByDurationDesc:
-- Worst ordering: DNFs go to the top (treated as "very bad"), then
-- non-DNFs by effective time descending.
SELECT * FROM solves WHERE user_id = :userId
ORDER BY is_dnf DESC, (duration_ms + penalty_ms) DESC LIMIT :limit OFFSET :offset;

selectById:
SELECT * FROM solves WHERE id = :id;

-- The five most recent solves at or before a given point in the
-- profile's timeline, newest first. This is the window an Ao5 is
-- computed over.
--
-- Ordered by (solved_at, id) so two solves recorded in the same
-- millisecond still have a total order, and the same one everywhere:
-- the migration's backfill window, this query, and the live computation
-- in SolveViewModel must agree or a solve's stored Ao5 stops matching
-- its stored ao5_times.
windowEndingAt:
SELECT * FROM solves
WHERE user_id = :userId AND (solved_at < :solvedAt OR (solved_at = :solvedAt AND id <= :id))
ORDER BY solved_at DESC, id DESC LIMIT 5;

-- Every solve whose Ao5 window contains the given solve – itself plus
-- the four that follow it. Used to find the rows whose ao5_ms/ao5_times
-- a penalty edit or a delete invalidates.
solvesAffectedByChangeAt:
SELECT * FROM solves
WHERE user_id = :userId AND (solved_at > :solvedAt OR (solved_at = :solvedAt AND id >= :id))
ORDER BY solved_at ASC, id ASC LIMIT 5;

-- Every solve for a profile in Ao5 window order. Used by the post-import
-- rebuild, which cannot rely on rows arriving in chronological order.
allAscending:
SELECT * FROM solves WHERE user_id = :userId ORDER BY solved_at ASC, id ASC;

updateAo5:
UPDATE solves SET ao5_ms = :ao5Ms, ao5_times = :ao5Times WHERE id = :id;

-- One cube's solves, newest first. The reason `solves_user_cube` exists:
-- (user_id, cube_mac) are both equalities and solved_at is the next
-- indexed column, so this pages straight off the index with no sort.
pageByCubeDateDesc:
SELECT * FROM solves WHERE user_id = :userId AND cube_mac = :cubeMac
ORDER BY solved_at DESC LIMIT :limit OFFSET :offset;

countForCube:
SELECT COUNT(*) AS solve_count FROM solves WHERE user_id = :userId AND cube_mac = :cubeMac;

-- Distinct cubes this profile has ever recorded a solve on, with a
-- count, newest activity first. Feeds a "filter by cube" control.
cubesUsed:
SELECT cube_mac AS mac, COUNT(*) AS solve_count, MAX(solved_at) AS last_solved_at
FROM solves
WHERE user_id = :userId AND cube_mac IS NOT NULL
GROUP BY cube_mac
ORDER BY last_solved_at DESC;

updatePenalty:
-- Mark a solve as DNF, +2, or back to OK. Called from the post-solve
-- buttons or from the History detail dialog (future).
UPDATE solves SET is_dnf = :isDnf, penalty_ms = :penaltyMs WHERE id = :id;
